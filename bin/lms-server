################################################################################
# ~/.config/systemd/user/lmstudio.service
################################################################################
#[Unit]
#Description=LM Studio Server
#After=network.target
#
#[Service]
#Type=forking
#ExecStartPre=-/home/sam/.lmstudio/bin/lms daemon down
#ExecStartPre=/home/sam/.lmstudio/bin/lms daemon up
#ExecStart=/home/sam/.lmstudio/bin/lms server start
#ExecStop=/home/sam/.lmstudio/bin/lms server stop
#ExecStopPost=/home/sam/.lmstudio/bin/lms daemon down
#RemainAfterExit=yes
#
#[Install]
#WantedBy=default.target
################################################################################
# Optional:
################################################################################
#systemctl --user daemon-reload
#systemctl --user enable lmstudio.service
#systemctl --user start lmstudio.service
################################################################################

if [ "$#" = 1 ] && [ ! "$1" = start ] && [ ! "$1" = stop ]; then
  echo ERROR must be start or stop as first arg. >&2
  exit 1
fi

systemctl --user "$1" lmstudio.service
